import FreeCAD as App
import Part

doc = App.activeDocument
# Iterate through all objects in the document to find the Pad001
pad001 = None
for obj in doc.Objects:
    if obj.Name == "Pad001":
        pad001 = obj
        break

if pad001:
    print(f"Found Pad001. Type: {type(pad001)}")
    shape = pad001.Shape
    print(f"Shape Type: {type(shape)}")
    if isinstance(shape, Part.Compound):
        print(f"Number of shapes in compound: {len(shape.Shapes)}")
        for i, s in enumerate(shape.Shapes):
            print(f"Shape {i}: {s.ShapeType} - Volume: {s.Volume}")
    else:
        print(f"Shape is not a compound: {shape.ShapeType} - Volume: {shape.Volume}")
else:
    print("Pad001 not found in active document.")

